{
  "name": "vt-calendar",
  "version": "1.0.0",
  "description": "VT Calendar - Course Calendar Consolidating Tool for Virginia Tech students",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "start": "node backend/start.js",
    "dev": "nodemon backend/app.py",
    "lint": "eslint frontend/public/**/*.js",
    "lint:fix": "eslint frontend/public/**/*.js --fix",
    "format": "prettier --write \"frontend/public/**/*.{js,html,css}\"",
    "format:check": "prettier --check \"frontend/public/**/*.{js,html,css}\""
  },
  "keywords": [
    "calendar",
    "canvas",
    "google-calendar",
    "virginia-tech",
    "student",
    "assignments",
    "scheduling"
  ],
  "author": "Ethan Lunsford, Sam Jordon, Shoumik Bisoi, Aryan Bhowmick",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AryanMick/VT-calendar.git"
  },
  "bugs": {
    "url": "https://github.com/AryanMick/VT-calendar/issues"
  },
  "homepage": "https://github.com/AryanMick/VT-calendar#readme",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@testing-library/dom": "^9.3.3",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/user-event": "^14.5.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/frontend/tests/setup.js"],
    "testMatch": [
      "<rootDir>/frontend/tests/**/*.test.js",
      "<rootDir>/frontend/public/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "frontend/public/*.js",
      "!frontend/public/*.test.js",
      "!frontend/public/node_modules/**",
      "!**/vendor/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "lcov"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/frontend/tests/__mocks__/styleMock.js"
    },
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testTimeout": 10000,
    "verbose": true
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "node": true,
      "jest": true
    },
    "extends": [
      "airbnb-base",
      "plugin:jest/recommended"
    ],
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "warn",
      "prefer-const": "error",
      "no-var": "error",
      "eqeqeq": "error",
      "no-eval": "error",
      "no-implied-eval": "error",
      "no-new-func": "error"
    },
    "globals": {
      "localStorage": "readonly",
      "sessionStorage": "readonly",
      "fetch": "readonly"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "arrowParens": "avoid",
    "endOfLine": "lf"
  },
  "nodemonConfig": {
    "watch": [
      "backend/"
    ],
    "ext": "py,js",
    "ignore": [
      "**/__tests__/**",
      "**/*.test.js"
    ],
    "exec": "python backend/app.py"
  }
}